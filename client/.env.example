# Browser-safe values only (NEXT_PUBLIC_ prefix). Placeholders, never commit real keys.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Phase 6 (required): used to build public URLs for photos in the `report-images`
# bucket (bucket is public-read; the API only ever returns storage paths, never URLs).
NEXT_PUBLIC_SUPABASE_URL=https://replace-me.supabase.co

# --- Phase 4 (required): Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Server-only: used by Next.js middleware, never prefix with NEXT_PUBLIC_
CLERK_SECRET_KEY=sk_test_replace_me

# Where Clerk's hosted components live and where to land after auth.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
