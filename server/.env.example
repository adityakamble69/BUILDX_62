# --- Phase 1 (required) ---
NODE_ENV=development
PORT=4000
# Deployed client URL in production (no trailing slash). localhost:3000 is always allowed.
CLIENT_ORIGIN=http://localhost:3000

# --- Phase 4 (required): Clerk ---
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# --- Phase 5 (required): Supabase ---
# Project Settings → API. The service-role key is server-only — never send it to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# --- Later phases (placeholders only, never commit real values) ---
# Phase 8
# AI_ENABLED=false
# AI_API_KEY=replace_me
