# --- Phase 1 (required) ---
NODE_ENV=development
PORT=4000
# Deployed client URL in production (no trailing slash). localhost:3000 is always allowed.
CLIENT_ORIGIN=http://localhost:3000

# --- Phase 4 (required): Clerk ---
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# --- Phase 5 (required): Supabase ---
# Project Settings → API. The service-role key is server-only — never send it to the client.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_me

# --- Phase 8 (optional): AI category + severity from the report photo ---
# Set AI_ENABLED=true and put a real key in AI_API_KEY. Without both, POST /ai/classify
# returns { enabled: false } and the report form still works.
# Provider: Gemini (Google AI Studio, key starts with AIza) or Anthropic (sk-ant-…).
# AI_PROVIDER=auto infers from the key. Override with gemini | anthropic if needed.
AI_ENABLED=false
AI_API_KEY=
AI_PROVIDER=auto
# AI_MODEL=gemini-2.0-flash
# AI_MODEL=claude-haiku-4-5-20251001
